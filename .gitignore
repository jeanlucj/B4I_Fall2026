# Credentials -- T3 BrAPI username/password
.Renviron

# Word lock files
~$*

# Per-trial BrAPI observation cache (regenerated by code/find_trials_with_B4I_accessions.R)
output/trial_cache/

# BGLR MCMC sample files (regenerated by code/BGLR_multi_trait_model.R).
# The *_beta.bin files are the streamed per-draw coefficients that the
# per-accession PEV is computed from -- ~14 MB per seed, ~57 MB in all.
output/BGLR_seed_*.dat
output/BGLR_seed_*_beta.bin
output/BGLR_*_As_draws_seed*.rds

# Simulation caches and MegaLMM run state
output/simulation/
output/simulation_runs/

# Pilot BGLR MCMC sample files
output/pilot/pilot_seed_*.dat

# SLURM job-array logs; the directory itself is kept (logs/.gitkeep)
logs/*
!logs/.gitkeep

# Stray default graphics device output from Rscript runs
Rplots.pdf
